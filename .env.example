# Copy to .env and fill in the key for the provider you use in config.toml.
# .env is gitignored - keys never get committed.

# zenmux (default provider in config.toml)
ZENMUX_API_KEY=

# openrouter
OPENROUTER_API_KEY=

# openai / compatible
OPENAI_API_KEY=

# local provider (ollama etc.) needs no key
